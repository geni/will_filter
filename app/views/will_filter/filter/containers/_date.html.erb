<table class='wf_values_table' cellspacing='0px' cellpadding='0px'>
  <tr>
    <td width='99%'>
      <%= text_field_tag "wf_v#{index}_0", container.sanitized_value(0), :class => 'wf_input', :style => 'width:99%', :onChange => 'wfFilter.fieldChanged(this)' %>
    </td>
    <td width='1%'>
      <%= link_to image_tag('will_filter/clock.png', :align => 'top', :title => 'select date & time', :border => '0', :class => 'wf_calendar_trigger'), '#', :onclick => "wfCalendar.selectDateTime('wf_v#{index}_0', this);return false;" %>
    </td>
  </tr>
</table>
