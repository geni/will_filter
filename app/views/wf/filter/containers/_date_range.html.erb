<table class='wf_values_table' cellspacing='0px' cellpadding='0px'>
	<tr>
    <td width='49%'>
      <%= text_field_tag "wf_v#{index}_0", container.sanitized_value(0), :class => 'wf_input', :style => 'width:99%', :onChange => 'wfFilter.fieldChanged(this)' %>
    </td>
		<td width='1%'>
	    <a href="#" onclick="wfCalendar.selectDate('wf_v<%=index%>_0', this); return false;">
	       <img align="top" title="select date" border="0" class="wf_calendar_trigger" src="/wf/images/calendar.png" />
	    </a>
    </td>
    <td width='49%'>
      <%= text_field_tag "wf_v#{index}_1", container.sanitized_value(1), :class => 'wf_input', :style => 'width:99%', :onChange => 'wfFilter.fieldChanged(this)' %>
    </td>
    <td width='1%'>
      <%= link_to_function image_tag('/wf/images/calendar.png', :align => 'top', :title => 'select date', :border => '0', :class => 'wf_calendar_trigger'), "wfCalendar.selectDate('wf_v#{index}_1', this)" %>
    </td>
	</tr>
</table>
