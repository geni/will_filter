<table class='wf_values_table' cellspacing='0px' cellpadding='0px'>
	<tr>
    <td width='49%'>
      <%= text_field_tag "wf_v#{index}_0", container.sanitized_value(0), :class => 'wf_input', :onChange => 'wfFilter.fieldChanged(this)' %>
    </td>
		<td width='1%'>
      <%= link_to_function image_tag('/wf/images/clock.png', :align => 'top', :title => 'select start date & time', :border => '0', :class => 'wf_calendar_trigger'), "wfCalendar.selectDateTime('wf_v#{index}_0', this)" %>
    </td>
    <td width='49%'>
      <%= text_field_tag "wf_v#{index}_1", container.sanitized_value(1), :class => 'wf_input', :onChange => 'wfFilter.fieldChanged(this)' %>
    </td>
    <td width='1%'>
      <%= link_to_function image_tag('/wf/images/clock.png', :align => 'top', :title => 'select end date & time', :border => '0', :class => 'wf_calendar_trigger'), "wfCalendar.selectDateTime('wf_v#{index}_1', this)" %>
    </td>
	</tr>
</table>
